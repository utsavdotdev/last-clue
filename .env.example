# The Last Clue — Environment Configuration

# Network host and port (Arduino App Lab publishes port 8765)
LAST_CLUE_HOST=0.0.0.0
LAST_CLUE_PORT=8765

# Local open-weight LLM endpoint (Arduino App Lab LLM brick or local llama-server)
LAST_CLUE_LLM_URL=http://llamacpp-models-runner:9999/v1/chat/completions
LAST_CLUE_LLM_MODEL=Qwen3.5-0.8B-Q4_0
LAST_CLUE_LLM_TIMEOUT=25
LAST_CLUE_AI_ENABLED=true

# Default timers in seconds
LAST_CLUE_DISCUSSION_SECONDS=60
LAST_CLUE_VOTING_SECONDS=45
LAST_CLUE_CLUE_TIMEOUT_SECONDS=45
LAST_CLUE_FINAL_GUESS_SECONDS=35

# Logging level (DEBUG, INFO, WARNING, ERROR)
LAST_CLUE_LOG_LEVEL=INFO
